# Local SQLite database for financial records and document metadata.
SQLITE_DATABASE_PATH=Data/financial_chatbot.sqlite3

# Optional: defaults to the project-local document_storage directory.
# DOCUMENT_STORAGE_DIR=C:\data\ai-pricing-copilot\documents

# Optional Groq API key for richer question interpretation and explanations.
GROQ_API_KEY=

# Replace these demo settings with strong, unique values before sharing.
AUTH_SALT=replace-with-a-random-secret
ADMIN_PASSWORD=replace-with-a-strong-password
FINANCE_PASSWORD=replace-with-a-strong-password
ITHEAD_PASSWORD=replace-with-a-strong-password
ANALYST_PASSWORD=replace-with-a-strong-password
HRMANAGER_PASSWORD=replace-with-a-strong-password
SALESHEAD_PASSWORD=replace-with-a-strong-password
